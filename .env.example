# Copy this file to .env and fill in real values locally.
# .env is gitignored and must never be committed.

# Hugging Face token, only needed if Qwen3-8B requires authentication
# for your account/region.
HUGGINGFACE_TOKEN=

# Reserved for later phases (email tool, Phase 4). Not used by Phase 1.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=

# Reserved for later phases (Phase 5 storage/database). Not used by Phase 1.
DATABASE_URL=
